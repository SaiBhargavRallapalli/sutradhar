# Sutradhar AI provider configuration
# ---------------------------------------------------------------------------------
# Copy this file to `.env` and fill in ONLY the provider you want to use.
# Sutradhar runs fully offline with deterministic planning and catalogue ideas
# when no provider is configured - you never need a key to get a complete plan.
#
# SECURITY NOTES
#   * `.env` is git-ignored. Never commit real credentials.
#   * Keys are read from the process environment only; they are never written to
#     logs, plan exports, or error messages (see sutradhar.ai.guardrails.redact).
#   * Prefer a scoped, low-privilege key with a spend limit.
# ---------------------------------------------------------------------------------

# Which provider to use: auto | openai | gemini | mock
#   auto  -> picks the first configured provider, otherwise falls back to `mock`.
SUTRADHAR_PROVIDER=auto

# --- OpenAI-compatible chat-completions providers -------------------------------
# Works with OpenAI, Azure-OpenAI-compatible gateways, Groq, Together, OpenRouter,
# Mistral, Fireworks, LM Studio, llama.cpp server, Ollama (/v1), vLLM, etc.
# SUTRADHAR_OPENAI_API_KEY=
# SUTRADHAR_OPENAI_BASE_URL=https://api.openai.com/v1
# SUTRADHAR_OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ----------------------------------------------------------------
# SUTRADHAR_GEMINI_API_KEY=
# SUTRADHAR_GEMINI_MODEL=gemini-2.5-flash

# --- Behaviour --------------------------------------------------------------------
# 0 disables AI enrichment entirely (pure deterministic planning).
SUTRADHAR_AI_ENABLED=1
# One repair keeps malformed model output recoverable without an unbounded bill.
SUTRADHAR_AI_MAX_REPAIRS=1
# Hard ceiling on outbound prompt size, in characters.
SUTRADHAR_AI_MAX_PROMPT_CHARS=6000
# Total seconds shared by the initial ideas call and its repair.
SUTRADHAR_AI_TIMEOUT=40
# Bounded process-local cache and public-URL cost controls.
SUTRADHAR_AI_CACHE_ENTRIES=128
SUTRADHAR_AI_CACHE_TTL=21600
SUTRADHAR_AI_DAILY_CAP=500
SUTRADHAR_AI_BREAKER_THRESHOLD=3
SUTRADHAR_AI_BREAKER_COOLDOWN=60
# Trust forwarded client addresses only behind a managed ingress such as Render.
SUTRADHAR_TRUST_PROXY=0
